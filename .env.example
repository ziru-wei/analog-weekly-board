# Google Cloud → APIs & Services → Credentials → OAuth client ID (type: Web application).
# Copy this file to .env.local and replace the placeholder; restart `npm run dev` afterwards.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Deployed auth worker (see worker/README.md). Enables long-lived sign-in in the Chrome/Firefox extensions.
VITE_AUTH_WORKER_URL=https://analog-weekly-board-auth.ziruw.workers.dev
# Optional: use a separate deployed metadata worker. Defaults to VITE_AUTH_WORKER_URL.
# VITE_PREVIEW_WORKER_URL=https://your-preview-worker.workers.dev
